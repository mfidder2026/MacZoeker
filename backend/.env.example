MONGO_URL=mongodb://localhost:27017
DB_NAME=mac_studio_zoeker
# Alleen deze frontend-adressen mogen de API aanroepen (komma-gescheiden).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Beveiliging ----
# Leeg = API zonder sleutel; draai de backend dan alleen op 127.0.0.1 (standaard).
# Wil je hem vanaf het netwerk/WSL bereiken (BACKEND_HOST=0.0.0.0)? Zet dan een lange
# willekeurige sleutel, bv. `python3 -c "import secrets;print(secrets.token_urlsafe(32))"`,
# en zet dezelfde waarde als REACT_APP_API_TOKEN in frontend/.env.
API_TOKEN=

# ---- LLM provider ----
# 'ollama' = lokale Ollama (OpenAI-compatibele server, aanbevolen voor Ubuntu/Linux).
# 'lmstudio' = lokale LM Studio (macOS-only).
# 'openai' = cloud-LLM (OpenAI, Mistral AI, Groq, Fireworks AI, etc.).
# 'emergent' = alleen op het Emergent-platform.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b-instruct-q5_K_M   # Exacte modelnaam uit `ollama list`
OLLAMA_API_KEY=ollama

# Alternatieve OpenAI-compatibele providers (gebruik één set variabelen):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-your-api-key

# ---- Anti-bot / JS-pagina's (echte browser via Playwright) ----
# true = probeer geblokkeerde/JS-pagina's opnieuw met een echte headless browser.
# Vereist eenmalig: pip install playwright && playwright install chromium
USE_PLAYWRIGHT=true
# Selenium als laatste fallback (vereist Chrome op de machine).
USE_SELENIUM=true

# ---- E-mailverzending (optioneel) ----
# Vul je SMTP-gegevens in om het dagelijkse rapport echt te versturen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Niet nodig lokaal (alleen op Emergent-platform):
# EMERGENT_LLM_KEY=
